DUTCHIE_API_BASE_URL=https://api.pos.dutchie.com

# Keep this as single-line JSON. Each API key is vendor/location-specific and permission-scoped.
DUTCHIE_LOCATIONS_JSON=[{"id":"example-dispensary","apiKey":"replace_me","latitude":40.4862,"longitude":-74.4518,"county":"Middlesex","distanceMiles":0}]

# Optional production database. When set, the API reads/writes Postgres instead of the local JSON warehouse.
DATABASE_URL=postgres://postgres:password@localhost:5432/leafradar
DATABASE_SSL=false

# Mobile app API target.
EXPO_PUBLIC_LEAFRADAR_API_URL=http://localhost:8787
